#!/usr/bin/env python3
"""kgl - control Kaggle notebook sandbox (Jupyter) from local terminal."""
import base64, json, os, subprocess, sys, time, uuid
from urllib.parse import quote

# ponytail: no proxy env, direct connection
for k in list(os.environ):
    if k.lower() in ("http_proxy", "https_proxy", "all_proxy"):
        del os.environ[k]

CONFDIR = os.path.expanduser("~/.config/kgl")
BASEFILE = os.path.join(CONFDIR, "base")
os.makedirs(CONFDIR, exist_ok=True)

import urllib.request


def curl(url, body=None, method=None):
    """Returns (status_code, text). Raises on transport failure."""
    cmd = ["curl", "-s", "--noproxy", "*", "-m", "20", "-w", "\n%{http_code}", url]
    if body is not None:
        cmd += ["-X", method or "POST", "--data-binary", "@" + body]
    elif method:
        cmd += ["-X", method]
    for i in range(3):  # ponytail: local proxy route is flaky
        p = subprocess.run(cmd, capture_output=True, text=True)
        if p.returncode == 0:
            break
        if p.returncode != 28 or i == 2:  # 28 = timeout, worth retrying
            sys.exit(f"curl failed ({p.returncode}): {p.stderr[:200]}")
    out, _, code = p.stdout.rpartition("\n")
    return int(code), out


def base():
    b = open(BASEFILE).read().strip()
    if not b:
        sys.exit("no base. run: kgl bootstrap")
    return b.rstrip("/")


def qpath(path):
    """URL-encode a remote path, preserving /."""
    return quote(path, safe="/")


def api(path, obj=None, method=None):
    """obj: python object -> JSON body written to temp file."""
    body = None
    try:
        if obj is not None:
            import tempfile
            f = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False)
            json.dump(obj, f)
            f.close()
            body = f.name
        code, out = curl(f"{base()}/{path}", body, method)
    finally:
        if body:
            os.unlink(body)
    if code >= 400:
        sys.exit(f"HTTP {code}: {out[:300]}")
    try:
        return json.loads(out)
    except Exception:
        sys.exit(f"bad json (HTTP {code}): {out[:200]}")


def _cdp_call(ws, method, params=None, want_id=None, timeout=10):
    import websocket as _w
    i = want_id or 1
    ws.send(json.dumps({"id": i, "method": method, "params": params or {}}))
    t0 = time.time()
    while time.time() - t0 < timeout:
        try:
            m = json.loads(ws.recv())
        except _w.WebSocketTimeoutException:
            continue
        if m.get("id") == i:
            return m
    return None


def _cookie_store():
    """Kaggle cookies: cached locally, refreshed from the 9222 browser if present."""
    cookiefile = os.path.join(CONFDIR, "cookies.json")
    src_browser = None
    try:
        ver = json.loads(subprocess.check_output(
            ["curl", "-s", "--noproxy", "*", "-m", "3", "http://localhost:9222/json/version"]))
        src_browser = ver["webSocketDebuggerUrl"]
    except Exception:
        pass
    if src_browser:
        import websocket
        ws = websocket.create_connection(src_browser, timeout=15, suppress_origin=True)
        r = _cdp_call(ws, "Storage.getCookies")
        cks = [c for c in (r["result"]["cookies"] if r else []) if "kaggle" in c["domain"]]
        if cks:
            KEYS = ("name", "value", "domain", "path", "secure", "httpOnly", "sameSite", "expires")
            slim = [{k: c[k] for k in KEYS if c.get(k) is not None} for c in cks]
            json.dump(slim, open(cookiefile, "w"))
            return slim
    if os.path.exists(cookiefile):
        return json.load(open(cookiefile))
    sys.exit("no kaggle cookies: open 9222 chrome once, or put cookies in "
             + cookiefile)


def bootstrap(note_arg=None):
    """Fully scripted: headless chrome mints the /k/ route. No visible window."""
    import subprocess, threading, websocket
    cookies = _cookie_store()
    port, prof = "9223", "/tmp/chrome-kaggle-headless"
    subprocess.run(["pkill", "-f", "chrome-kaggle-headless"], capture_output=True)
    time.sleep(0.5)
    chrome = ("/Applications/Google Chrome.app/Contents/MacOS/Google Chrome")
    proc = subprocess.Popen([chrome, "--headless=new", f"--remote-debugging-port={port}",
        f"--user-data-dir={prof}", "--no-first-run", "--disable-gpu"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        for _ in range(10):
            try:
                ver = json.loads(subprocess.check_output(
                    ["curl", "-s", "--noproxy", "*", "-m", "2", f"http://localhost:{port}/json/version"]))
                break
            except Exception:
                time.sleep(0.5)
        else:
            sys.exit("headless chrome did not start")
        bws = websocket.create_connection(ver["webSocketDebuggerUrl"], timeout=90, suppress_origin=True)
        bws.send(json.dumps({"id": 1, "method": "Storage.setCookies", "params": {"cookies": cookies}}))
        t0 = time.time()
        while time.time() - t0 < 5:
            try:
                if json.loads(bws.recv()).get("id") == 1:
                    break
            except websocket.WebSocketTimeoutException:
                continue
        bws.send(json.dumps({"id": 2, "method": "Target.setDiscoverTargets", "params": {"discover": True}}))
        found = []
        seen = set()

        def handle(m):
            meth = m.get("method", "")
            if meth in ("Target.targetCreated", "Target.targetInfoChanged"):
                ti = m["params"]["targetInfo"]
                if ti["type"] in ("page", "iframe") and ti["targetId"] not in seen:
                    seen.add(ti["targetId"])
                    bws.send(json.dumps({"id": abs(hash(ti["targetId"])) % 99991,
                        "method": "Target.attachToTarget",
                        "params": {"targetId": ti["targetId"], "flatten": True}}))
            if "result" in m and "sessionId" in m.get("result", {}):
                bws.send(json.dumps({"id": 3, "method": "Network.enable",
                                     "sessionId": m["result"]["sessionId"]}))
            if meth == "Network.requestWillBeSent":
                u = m["params"]["request"]["url"]
                if "/proxy/api/" in u:
                    found.append(u.split("/proxy/")[0] + "/proxy")

        def pump():
            while len(found) < 1:
                try:
                    handle(json.loads(bws.recv()))
                except websocket.WebSocketTimeoutException:
                    continue
                except Exception:
                    return
        th = threading.Thread(target=pump, daemon=True)
        th.start()
        subprocess.run(["curl", "-s", "-X", "PUT",
            f"http://localhost:{port}/json/new?https://www.kaggle.com/code"], capture_output=True)
        # also open the notebook edit page — /k/ only appears with an active session
        nbfile = os.path.join(CONFDIR, "notebook")
        nb = note_arg or (open(nbfile).read().strip() if os.path.exists(nbfile) else "")
        if not nb:
            sys.exit("usage: kgl bootstrap <notebook-owner/slug>  (saved for next time)")
        open(nbfile, "w").write(nb)
        tabs = json.loads(subprocess.check_output(
            ["curl", "-s", "--noproxy", "*", f"http://localhost:{port}/json/list"]))
        page = next((t for t in tabs if t["type"] == "page" and "kaggle.com" in t["url"]), None)
        if page:
            pws = websocket.create_connection(page["webSocketDebuggerUrl"], timeout=20, suppress_origin=True)
            pws.send(json.dumps({"id": 1, "method": "Page.navigate",
                "params": {"url": f"https://www.kaggle.com/code/{nb}/edit"}}))
        th.join(timeout=75)
        if found:
            open(BASEFILE, "w").write(found[0])
            print("saved:", found[0][:80] + "…")
        else:
            sys.exit("bootstrap failed: cookies expired? re-login in 9222 chrome and retry")
    finally:
        proc.terminate()


def pick_kernel_id():
    """Kernel of the notebook session, KGL_KERNEL override, else fail loudly."""
    if os.environ.get("KGL_KERNEL"):
        return os.environ["KGL_KERNEL"]
    sessions = api("api/sessions")
    if not sessions:
        sys.exit("no running session; run a cell in the notebook first")
    for s in sessions:
        if s.get("path") == "__notebook_source__.ipynb":
            return s["kernel"]["id"]
    sys.exit("multiple sessions and no notebook match; pick one:\n" +
             "\n".join(f'  {s["kernel"]["id"]}  {s.get("path")}' for s in sessions))


def ws_kernel(kernel_id=None):
    import websocket
    kid = kernel_id or pick_kernel_id()
    url = base().replace("https://", "wss://") + f"/api/kernels/{kid}/channels"
    # ponytail: local proxy route is flaky; 3 attempts
    for i in range(3):
        try:
            return websocket.create_connection(url, timeout=15, suppress_origin=False, origin=base())
        except Exception as e:
            if i == 2:
                raise
            time.sleep(1)


def run_code(code, timeout=600, kernel_id=None):
    """Returns process-style exit code: 0 ok, 1 error, 124 timeout."""
    ws = ws_kernel(kernel_id)
    mid = str(uuid.uuid4())
    ws.send(json.dumps({
        "header": {"msg_id": mid, "msg_type": "execute_request", "username": "kgl",
                   "session": "kgl-local", "version": "5.3"},
        "parent_header": {}, "metadata": {}, "buffers": [],
        "content": {"code": code, "silent": False, "store_history": True,
                    "user_expressions": {}, "allow_stdin": False}}))
    import websocket as _w
    t0 = time.time()
    while time.time() - t0 < timeout:
        try:
            m = json.loads(ws.recv())
        except _w.WebSocketTimeoutException:
            continue  # quiet execution; keep waiting until overall timeout
        if m.get("parent_header", {}).get("msg_id") != mid:
            continue
        t = m["msg_type"]
        if t == "stream":
            print(m["content"]["text"], end="",
                  file=sys.stderr if m["content"].get("name") == "stderr" else sys.stdout)
        elif t == "execute_result":
            print(m["content"]["data"].get("text/plain", ""), end="")
        elif t == "error":
            print("\n".join(m["content"]["traceback"][-6:]), file=sys.stderr)
            return 1
        elif t == "status" and m["content"]["execution_state"] == "idle":
            return 0
    print(f"(timeout after {timeout}s; execution may still be running remotely)", file=sys.stderr)
    return 124


def main():
    if len(sys.argv) < 2:
        print("usage: kgl bootstrap|status|exec CODE|sh CMD|get REMOTE [LOCAL]|put LOCAL REMOTE|term", file=sys.stderr)
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "bootstrap":
        return bootstrap(sys.argv[2] if len(sys.argv) > 2 else None)
    if cmd == "status":
        print(json.dumps(api("api/kernels"), indent=1))
        print("terminals:", json.dumps(api("api/terminals")))
        return
    if cmd == "exec":
        return sys.exit(run_code(sys.argv[2], kernel_id=os.environ.get("KGL_KERNEL")))
    if cmd == "sh":
        # exit-code marker goes to stderr; stdout stays verbatim.
        # ponytail: remote output decoded with errors=replace (binary-safe);
        # byte-exact binary output should go through files + kgl get.
        # Runs via exec in a throwaway namespace so notebook variables are untouched.
        inner = (
            "import subprocess,sys\n"
            "p=subprocess.run(%r,shell=True,capture_output=True)\n"
            "def d(b):\n"
            "    try:\n"
            "        return b.decode('utf-8'),False\n"
            "    except UnicodeDecodeError:\n"
            "        return b.decode('utf-8','replace'),True\n"
            "so,bo=d(p.stdout)\n"
            "se,be=d(p.stderr)\n"
            "sys.stdout.write(so)\n"
            "sys.stderr.write(se)\n"
            "print(f'[exit {p.returncode} badutf={bo or be}]',file=sys.stderr)\n"
            ) % sys.argv[2]
        # repr() embeds the wrapper verbatim (no second string-parse of the
        # command); exec in a throwaway dict touches no notebook global
        code = "exec(%s, {})" % repr(inner)
        import io, contextlib
        buf_out, buf_err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(buf_out), contextlib.redirect_stderr(buf_err):
            rc = run_code(code, kernel_id=os.environ.get("KGL_KERNEL"))
        out, err = buf_out.getvalue(), buf_err.getvalue()
        rc_shell, badutf = 1, False
        if rc == 0 and "[exit " in err:
            idx = err.rfind("[exit ")
            tail = err[idx:].split("]")[0].split()
            rc_shell = int(tail[1])
            badutf = "badutf=True" in tail
            err = err[:idx]  # drop marker suffix exactly; command bytes untouched
        sys.stdout.write(out)
        sys.stderr.write(err)
        if badutf:
            print("warning: output contained invalid UTF-8 (shown as replacement chars); "
                  "use kgl put/get files for exact bytes", file=sys.stderr)
        sys.exit(rc_shell if rc == 0 else rc)
    if cmd == "get":
        remote = sys.argv[2]
        r = api(f"api/contents/{qpath(remote)}?content=1")
        out = sys.argv[3] if len(sys.argv) > 3 else os.path.basename(remote)
        if r["format"] == "text":
            open(out, "w").write(r["content"])
        elif r["format"] == "json":
            open(out, "w").write(json.dumps(r["content"], indent=1))
        elif r["format"] == "base64":
            open(out, "wb").write(base64.b64decode(r["content"]))
        else:
            sys.exit(f"format {r['format']} not supported")
        print(f"wrote {out} ({os.path.getsize(out)} bytes)")
        return
    if cmd == "put":
        local, remote = sys.argv[2], sys.argv[3]
        parent = os.path.dirname(remote.strip("/"))
        for i, _ in enumerate(parent.split("/")) if parent else []:
            sub = "/".join(parent.split("/")[:i + 1])
            try:
                api(f"api/contents/{qpath(sub)}", {"type": "directory"}, "PUT")
            except SystemExit:
                pass  # already exists
        data = open(local, "rb").read()
        body = {"type": "file", "format": "base64",
                "content": base64.b64encode(data).decode()}
        r = api(f"api/contents/{qpath(remote)}", body, "PUT")
        print("put ok:", r["path"])
        return
    if cmd == "term":
        # Kaggle's jupyter-proxy does not expose the terminado websocket
        # (/api/terminals/websocket/N always 404s; their "console" is kernel-based).
        sys.exit("kgl term unsupported: kaggle blocks the terminal websocket; "
                 "use kgl sh / exec (kernel channel works fine)")
    sys.exit(f"unknown cmd {cmd}")


if __name__ == "__main__":
    main()
