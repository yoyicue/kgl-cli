#!/usr/bin/env python3
"""kgl - control Kaggle notebook sandbox (Jupyter) from local terminal."""
import base64, json, os, subprocess, sys, time, uuid
from urllib.parse import quote

# ponytail: no proxy env, direct connection
for k in list(os.environ):
    if k.lower() in ("http_proxy", "https_proxy", "all_proxy"):
        del os.environ[k]

CONFDIR = os.path.expanduser("~/.config/kgl")
BASEFILE = os.path.join(CONFDIR, "base")
os.makedirs(CONFDIR, mode=0o700, exist_ok=True)
try:
    os.chmod(CONFDIR, 0o700)  # tighten pre-existing dirs from older versions
except OSError:
    pass

import urllib.request


def curl(url, body=None, method=None):
    """Returns (status_code, text). URL (embeds the JWE credential) goes via a
    0600 curl config file, never argv. Raises on transport failure."""
    import tempfile
    kf = tempfile.NamedTemporaryFile("w", suffix=".kgl", delete=False)
    try:
        os.chmod(kf.name, 0o600)
        kf.write(f'url = "{url}"\n')
        kf.close()
        cmd = ["curl", "-s", "--noproxy", "*", "-m", "20", "-w", "\n%{http_code}", "-K", kf.name]
        if body is not None:
            cmd += ["-X", method or "POST", "--data-binary", "@" + body]
        elif method:
            cmd += ["-X", method]
        for i in range(3):  # ponytail: local proxy route is flaky
            p = subprocess.run(cmd, capture_output=True, text=True)
            if p.returncode == 0:
                break
            if p.returncode != 28 or i == 2:  # 28 = timeout, worth retrying
                sys.exit(f"curl failed ({p.returncode}): {p.stderr[:200]}")
        out, _, code = p.stdout.rpartition("\n")
        return int(code), out
    finally:
        os.unlink(kf.name)


def base():
    b = open(BASEFILE).read().strip()
    if not b:
        sys.exit("no base. run: kgl bootstrap")
    return b.rstrip("/")


def qpath(path):
    """URL-encode a remote path, preserving /."""
    return quote(path, safe="/")


def api(path, obj=None, method=None):
    """obj: python object -> JSON body written to temp file."""
    body = None
    try:
        if obj is not None:
            import tempfile
            f = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False)
            json.dump(obj, f)
            f.close()
            body = f.name
        code, out = curl(f"{base()}/{path}", body, method)
    finally:
        if body:
            os.unlink(body)
    if code >= 400:
        sys.exit(f"HTTP {code}: {out[:300]}")
    try:
        return json.loads(out)
    except Exception:
        sys.exit(f"bad json (HTTP {code}): {out[:200]}")


def _cdp_call(ws, method, params=None, want_id=None, timeout=10):
    import websocket as _w
    i = want_id or 1
    ws.send(json.dumps({"id": i, "method": method, "params": params or {}}))
    t0 = time.time()
    while time.time() - t0 < timeout:
        try:
            m = json.loads(ws.recv())
        except _w.WebSocketTimeoutException:
            continue
        if m.get("id") == i:
            return m
    return None


def _cookie_store():
    """Kaggle cookies: cached locally, refreshed from the 9222 browser if present."""
    cookiefile = os.path.join(CONFDIR, "cookies.json")
    src_browser = None
    try:
        ver = json.loads(subprocess.check_output(
            ["curl", "-s", "--noproxy", "*", "-m", "3", "http://localhost:9222/json/version"]))
        src_browser = ver["webSocketDebuggerUrl"]
    except Exception:
        pass
    cached = None
    if os.path.exists(cookiefile):
        cached = json.load(open(cookiefile))
    if src_browser:
        import websocket
        try:
            ws = websocket.create_connection(src_browser, timeout=15, suppress_origin=True)
            r = _cdp_call(ws, "Storage.getCookies")
            cks = [c for c in (r["result"]["cookies"] if r else []) if "kaggle" in c["domain"]]
            if cks:
                KEYS = ("name", "value", "domain", "path", "secure", "httpOnly", "sameSite", "expires")
                slim = [{k: c[k] for k in KEYS if c.get(k) is not None} for c in cks]
                # verify freshness: XSRF+session must answer an API call
                CK = "; ".join(f"{c['name']}={c['value']}" for c in slim)
                XSRF = [p.split("=", 1)[1] for p in CK.split("; ") if p.startswith("XSRF-TOKEN=")]
                if XSRF:
                    code, out = _post_json(
                        "https://www.kaggle.com/api/i/users.UsersService/GetCurrentUser",
                        {}, {"x-xsrf-token": XSRF[0], "cookie": CK})
                    out = json.dumps(out or {})
                    if '"userId"' in out or '"user"' in out:
                        json.dump(slim, open(cookiefile, "w"))
                        os.chmod(cookiefile, 0o600)
                        return slim
        except Exception:
            pass
    if cached:
        return cached
    if os.path.exists(cookiefile):
        return json.load(open(cookiefile))
    sys.exit("no kaggle cookies: open 9222 chrome once, or put cookies in "
             + cookiefile)


def _secure_write(path, data):
    """Write with 0600 — cookies/base hold live credentials; also tightens
    files created by older versions with wider modes."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, data if isinstance(data, bytes) else data.encode())
    finally:
        os.close(fd)
    os.chmod(path, 0o600)


def _post_json(url, body_obj, headers):
    """POST via curl; credentials via 0600 -K config file and stdin body
    (nothing secret in argv / process list). Returns (code, json-or-None)."""
    import tempfile
    kf = tempfile.NamedTemporaryFile("w", suffix=".kgl", delete=False)
    os.chmod(kf.name, 0o600)
    for h, v in headers.items():
        kf.write(f'header = "{h}: {v}"\n')
    kf.close()
    try:
        p = None
        for i in range(3):  # ponytail: local route to kaggle is flaky; retry transient failures
            p = subprocess.run(
                ["curl", "-s", "--noproxy", "*", "-m", "20", "-w", "\n%{http_code}",
                 "-K", kf.name, url, "-H", "content-type: application/json",
                 "--data-binary", "@-"],
                input=json.dumps(body_obj).encode(), capture_output=True)
            if p.returncode == 0 and p.stdout:
                break
            time.sleep(1)
    finally:
        os.unlink(kf.name)
    if p is None or p.returncode != 0:
        return 0, None
    out, _, code = p.stdout.decode().rpartition("\n")
    try:
        return int(code), json.loads(out) if out else None
    except ValueError:
        return int(code or 0), None


def _auth_err(code, body):
    """Map HTTP failures to actionable messages."""
    err = body.get("error") if isinstance(body, dict) else None
    perm = isinstance(err, dict) and err.get("status") == "PERMISSION_DENIED"
    if code == 403 or perm:
        return ("auth failed (403): kaggle cookies expired — re-login in any "
                "chrome and re-run with 9222 debugging on, or refresh "
                "~/.config/kgl/cookies.json")
    if code == 404:
        return f"not found (404): {str(body)[:150]}"
    if code == 0:
        return f"network failure: {str(body)[:150]}"
    return f"HTTP {code}: {str(body)[:200]}"


def _select_session(sessions, which):
    """Pick exactly one session by title substring or kernelRunId; refuse to guess."""
    if not sessions:
        sys.exit("no interactive session; run a cell in the notebook once")
    if which:
        cand = [s for s in sessions if which.isdigit() and str(s["kernelRunId"]) == which
                or which.lower() in s.get("title", "").lower()]
    else:
        cand = sessions if len(sessions) == 1 else []
    if len(cand) != 1:
        sys.exit("ambiguous/unknown session — pick one:\n" +
                 "\n".join(f'  kgl bootstrap "{s["title"]}"   (kernelRunId {s["kernelRunId"]})'
                           for s in sessions))
    return cand[0]


def bootstrap(which=None):
    """Pure-HTTP mint of the /k/ route — no browser at all.

    Chain: kaggle cookies -> GetFirebaseAuthToken -> signInWithCustomToken
    (kkb-production) -> UpdateUserKernelFirestoreAuth (session doc id)
    -> Firestore REST read sessions/<doc>/data/JupyterURL.
    which: session title substring or kernelRunId to disambiguate.
    """
    FB_KEY = "AIzaSyD83TRC5oxzFh-vaPb_4X2tHBigTcgkD0Y"  # kkb-production web key
    cookies = _cookie_store()
    CK = "; ".join(f"{c['name']}={c['value']}" for c in cookies)
    xsrf = [p.split("=", 1)[1] for p in CK.split("; ") if p.startswith("XSRF-TOKEN=")]
    if not xsrf:
        sys.exit("cookies have no XSRF-TOKEN — expired? re-login to kaggle "
                 "and refresh ~/.config/kgl/cookies.json")
    XSRF = xsrf[0]

    def kgl_api(method, body="{}"):
        code, out = _post_json(
            f"https://www.kaggle.com/api/i/kernels.KernelsService/{method}",
            json.loads(body), {"x-xsrf-token": XSRF, "cookie": CK})
        if code >= 400 or out is None:
            sys.exit(f"{method}: " + _auth_err(code, out))
        return out

    sessions = kgl_api("ListKernelSessions").get("sessions", [])
    run = _select_session(sessions, which)
    run_id = run["kernelRunId"]
    print(f"session: {run['title']} (kernelRunId {run_id})")

    tok = kgl_api("GetFirebaseAuthToken")["authToken"]
    code, out = _post_json(
        f"https://identitytoolkit.googleapis.com/v1/accounts:signInWithCustomToken?key={FB_KEY}",
        {"token": tok, "returnSecureToken": True}, {})
    if code >= 400 or not (out or {}).get("idToken"):
        sys.exit("firebase signIn: " + _auth_err(code, out))
    idt = out["idToken"]

    upd = kgl_api("UpdateUserKernelFirestoreAuth",
                  json.dumps({"firebaseIdToken": idt, "kernelRunId": run_id}))
    doc = upd.get("sessionId")
    if not doc:
        sys.exit("UpdateUserKernelFirestoreAuth returned empty sessionId: " + str(upd)[:150])

    # GET via -K config (Bearer never in argv), same retry policy
    import tempfile
    kf = tempfile.NamedTemporaryFile("w", suffix=".kgl", delete=False)
    os.chmod(kf.name, 0o600)
    kf.write(f'header = "Authorization: Bearer {idt}"\n')
    kf.close()
    try:
        p = None
        for i in range(3):
            p = subprocess.run(
                ["curl", "-s", "--noproxy", "*", "-m", "20", "-w", "\n%{http_code}", "-K", kf.name,
                 f"https://firestore.googleapis.com/v1/projects/kkb-production/databases/(default)/"
                 f"documents/sessions/{doc}/data/JupyterURL"],
                capture_output=True)
            if p.returncode == 0 and p.stdout:
                break
            time.sleep(1)
    finally:
        os.unlink(kf.name)
    out, _, code = p.stdout.decode().rpartition("\n") if p and p.stdout else ("", "", "0")
    try:
        url = json.loads(out)["fields"]["url"]["stringValue"]
    except Exception:
        sys.exit("JupyterURL read: " + _auth_err(int(code or 0), out[:200]))
    _secure_write(BASEFILE, url.rstrip("/") + "\n")
    print("saved:", url[:90] + "…")


def pick_kernel_id():
    """Kernel of the notebook session, KGL_KERNEL override, else fail loudly."""
    if os.environ.get("KGL_KERNEL"):
        return os.environ["KGL_KERNEL"]
    sessions = api("api/sessions")
    if not sessions:
        sys.exit("no running session; run a cell in the notebook first")
    for s in sessions:
        if s.get("path") == "__notebook_source__.ipynb":
            return s["kernel"]["id"]
    sys.exit("multiple sessions and no notebook match; pick one:\n" +
             "\n".join(f'  {s["kernel"]["id"]}  {s.get("path")}' for s in sessions))


def ws_kernel(kernel_id=None):
    import websocket
    kid = kernel_id or pick_kernel_id()
    url = base().replace("https://", "wss://") + f"/api/kernels/{kid}/channels"
    # ponytail: local proxy route is flaky; 3 attempts
    for i in range(3):
        try:
            return websocket.create_connection(url, timeout=15, suppress_origin=False, origin=base())
        except Exception as e:
            if i == 2:
                raise
            time.sleep(1)


def run_code(code, timeout=600, kernel_id=None):
    """Returns process-style exit code: 0 ok, 1 error, 124 timeout."""
    ws = ws_kernel(kernel_id)
    mid = str(uuid.uuid4())
    ws.send(json.dumps({
        "header": {"msg_id": mid, "msg_type": "execute_request", "username": "kgl",
                   "session": "kgl-local", "version": "5.3"},
        "parent_header": {}, "metadata": {}, "buffers": [],
        "content": {"code": code, "silent": False, "store_history": True,
                    "user_expressions": {}, "allow_stdin": False}}))
    import websocket as _w
    t0 = time.time()
    while time.time() - t0 < timeout:
        try:
            m = json.loads(ws.recv())
        except _w.WebSocketTimeoutException:
            continue  # quiet execution; keep waiting until overall timeout
        if m.get("parent_header", {}).get("msg_id") != mid:
            continue
        t = m["msg_type"]
        if t == "stream":
            print(m["content"]["text"], end="",
                  file=sys.stderr if m["content"].get("name") == "stderr" else sys.stdout)
        elif t == "execute_result":
            print(m["content"]["data"].get("text/plain", ""), end="")
        elif t == "error":
            print("\n".join(m["content"]["traceback"][-6:]), file=sys.stderr)
            return 1
        elif t == "status" and m["content"]["execution_state"] == "idle":
            return 0
    print(f"(timeout after {timeout}s; execution may still be running remotely)", file=sys.stderr)
    return 124


def main():
    if len(sys.argv) < 2:
        print("usage: kgl bootstrap|status|exec CODE|sh CMD|get REMOTE [LOCAL]|put LOCAL REMOTE|term", file=sys.stderr)
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "bootstrap":
        return bootstrap(sys.argv[2] if len(sys.argv) > 2 else None)
    if cmd == "status":
        print(json.dumps(api("api/kernels"), indent=1))
        print("terminals:", json.dumps(api("api/terminals")))
        return
    if cmd == "exec":
        return sys.exit(run_code(sys.argv[2], kernel_id=os.environ.get("KGL_KERNEL")))
    if cmd == "sh":
        # exit-code marker goes to stderr; stdout stays verbatim.
        # ponytail: remote output decoded with errors=replace (binary-safe);
        # byte-exact binary output should go through files + kgl get.
        # Runs via exec in a throwaway namespace so notebook variables are untouched.
        inner = (
            "import subprocess,sys\n"
            "p=subprocess.run(%r,shell=True,capture_output=True)\n"
            "def d(b):\n"
            "    try:\n"
            "        return b.decode('utf-8'),False\n"
            "    except UnicodeDecodeError:\n"
            "        return b.decode('utf-8','replace'),True\n"
            "so,bo=d(p.stdout)\n"
            "se,be=d(p.stderr)\n"
            "sys.stdout.write(so)\n"
            "sys.stderr.write(se)\n"
            "print(f'[exit {p.returncode} badutf={bo or be}]',file=sys.stderr)\n"
            ) % sys.argv[2]
        # repr() embeds the wrapper verbatim (no second string-parse of the
        # command); exec in a throwaway dict touches no notebook global
        code = "exec(%s, {})" % repr(inner)
        import io, contextlib
        buf_out, buf_err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(buf_out), contextlib.redirect_stderr(buf_err):
            rc = run_code(code, kernel_id=os.environ.get("KGL_KERNEL"))
        out, err = buf_out.getvalue(), buf_err.getvalue()
        rc_shell, badutf = 1, False
        if rc == 0 and "[exit " in err:
            idx = err.rfind("[exit ")
            tail = err[idx:].split("]")[0].split()
            rc_shell = int(tail[1])
            badutf = "badutf=True" in tail
            err = err[:idx]  # drop marker suffix exactly; command bytes untouched
        sys.stdout.write(out)
        sys.stderr.write(err)
        if badutf:
            print("warning: output contained invalid UTF-8 (shown as replacement chars); "
                  "use kgl put/get files for exact bytes", file=sys.stderr)
        sys.exit(rc_shell if rc == 0 else rc)
    if cmd == "get":
        remote = sys.argv[2]
        r = api(f"api/contents/{qpath(remote)}?content=1")
        out = sys.argv[3] if len(sys.argv) > 3 else os.path.basename(remote)
        if r["format"] == "text":
            open(out, "w").write(r["content"])
        elif r["format"] == "json":
            open(out, "w").write(json.dumps(r["content"], indent=1))
        elif r["format"] == "base64":
            open(out, "wb").write(base64.b64decode(r["content"]))
        else:
            sys.exit(f"format {r['format']} not supported")
        print(f"wrote {out} ({os.path.getsize(out)} bytes)")
        return
    if cmd == "put":
        local, remote = sys.argv[2], sys.argv[3]
        parent = os.path.dirname(remote.strip("/"))
        for i, _ in enumerate(parent.split("/")) if parent else []:
            sub = "/".join(parent.split("/")[:i + 1])
            try:
                api(f"api/contents/{qpath(sub)}", {"type": "directory"}, "PUT")
            except SystemExit:
                pass  # already exists
        data = open(local, "rb").read()
        body = {"type": "file", "format": "base64",
                "content": base64.b64encode(data).decode()}
        r = api(f"api/contents/{qpath(remote)}", body, "PUT")
        print("put ok:", r["path"])
        return
    if cmd == "term":
        # Kaggle's jupyter-proxy does not expose the terminado websocket
        # (/api/terminals/websocket/N always 404s; their "console" is kernel-based).
        sys.exit("kgl term unsupported: kaggle blocks the terminal websocket; "
                 "use kgl sh / exec (kernel channel works fine)")
    sys.exit(f"unknown cmd {cmd}")


if __name__ == "__main__":
    main()
