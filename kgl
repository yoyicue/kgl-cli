def _headless_action(action, wait=30, timeout=120):
    """Drive the Kaggle editor in headless chrome for browser-gated actions
    (stop / run-all / save — their RPCs 403 outside a browser context).
    Returns 0 on VERIFIED success, 1 on failure. Large viewport required:
    session controls are hidden below ~1280px."""
    import subprocess, tempfile, shutil, websocket
    cookies = _cookie_store()
    slug = _notebook_slug()
    profile = tempfile.mkdtemp(prefix="kgl-chrome-")
    proc = subprocess.Popen(
        [_chrome_bin(), "--headless=new", "--remote-debugging-port=0",
         f"--user-data-dir={profile}", "--no-first-run", "--disable-gpu",
         "--window-size=1920,1080"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        # port 0 -> chrome picks a free one and writes it to DevToolsActivePort
        port = None
        for _ in range(20):
            f = os.path.join(profile, "DevToolsActivePort")
            if os.path.exists(f):
                port = int(open(f).read().split()[0])
                break
            time.sleep(0.5)
        if not port:
            sys.exit("headless chrome did not start (no DevToolsActivePort)")
        ver = json.loads(subprocess.check_output(
            ["curl", "-s", "--noproxy", "*", "-m", "3",
             f"http://localhost:{port}/json/version"]))
        if "Chrome" not in ver.get("Browser", "") and "Chromium" not in ver.get("Browser", ""):
            sys.exit(f"unexpected CDP endpoint: {ver.get('Browser')}")
        ws = websocket.create_connection(ver["webSocketDebuggerUrl"], timeout=20,
                                         suppress_origin=True)
        ws.send(json.dumps({"id": 1, "method": "Storage.setCookies",
                            "params": {"cookies": cookies}}))
        t0 = time.time()
        while time.time() - t0 < 5:
            try:
                if json.loads(ws.recv()).get("id") == 1:
                    break
            except websocket.WebSocketTimeoutException:
                continue
        # create the tab and capture ITS id — never operate an unrelated tab
        tab = json.loads(subprocess.check_output(
            ["curl", "-s", "--noproxy", "*", "-m", "10", "-X", "PUT",
             f"http://localhost:{port}/json/new?https://www.kaggle.com/code/{slug}/edit"]))
        tab_id = tab["id"]
        time.sleep(wait)

        def find_tab_ws():
            tabs = json.loads(subprocess.check_output(
                ["curl", "-s", "--noproxy", "*", f"http://localhost:{port}/json/list"]))
            for t in tabs:
                if t.get("id") == tab_id and slug.split("/")[-1] in t.get("url", ""):
                    return websocket.create_connection(t["webSocketDebuggerUrl"],
                                                       timeout=30, suppress_origin=True)
            return None

        def click(expr):
            pws = find_tab_ws()
            if not pws:
                return "tab-lost"
            pws.send(json.dumps({"id": 1, "method": "Runtime.evaluate",
                                 "params": {"expression": expr, "returnByValue": True}}))
            t0 = time.time()
            while time.time() - t0 < 10:
                try:
                    m = json.loads(pws.recv())
                except websocket.WebSocketTimeoutException:
                    continue
                if m.get("id") == 1:
                    pws.close()
                    return m["result"]["result"].get("value")
            return "no-response"

        def sessions_now():
            d = _kgl_cookie_api("ListKernelSessions", {})
            return {s["kernelRunId"] for s in (d or {}).get("sessions", [])}

        if action == "stop":
            before = sessions_now()
            r = click("(()=>{const b=[...document.querySelectorAll('button')]"
                      ".find(b=>(b.getAttribute('aria-label')||'')==='Stop session');"
                      "if(!b) return 'no-stop-btn'; b.click(); return 'stop-clicked';})()")
            print(r)
            if "clicked" not in str(r):
                return 1
            t0 = time.time()  # verify server-side teardown
            while time.time() - t0 < timeout:
                if not (sessions_now() & before):
                    print("stopped (verified)")
                    return 0
                time.sleep(8)
            print(f"stop not confirmed within {timeout}s", file=sys.stderr)
            return 1
        if action == "run-all":
            before = sessions_now()
            r = click("(()=>{const b=[...document.querySelectorAll('button')]"
                      ".find(b=>/Run All/i.test(b.getAttribute('aria-label')||b.innerText));"
                      "if(!b) return 'no-runall'; b.click(); return 'runall-clicked';})()")
            print(r)
            if "clicked" not in str(r):
                return 1
            t0 = time.time()  # verify a session actually spins up
            while time.time() - t0 < timeout:
                if sessions_now() - before:
                    print("session started (verified)")
                    return 0
                time.sleep(10)
            print(f"no new session within {timeout}s", file=sys.stderr)
            return 1
        if action == "save":
            CK = "; ".join(f"{c['name']}={c['value']}" for c in cookies)
            before = len((_kgl_cookie_api("ListKernelVersions",
                         {"kernelId": _notebook_kernel_id()}) or {}).get("items", []))
            r = click("(()=>{const b=[...document.querySelectorAll('button')]"
                      ".find(b=>/Save Version/.test(b.innerText));"
                      "if(!b) return 'no-save'; b.click(); return 'sv-clicked';})()")
            time.sleep(5)
            r2 = click("(()=>{const bs=[...document.querySelectorAll('button')]"
                       ".filter(b=>b.innerText.trim()==='Save');"
                       "if(!bs.length) return 'no-confirm'; bs[bs.length-1].click();"
                       "return 'saved';})()")
            print(r, "/", r2)
            if "saved" not in str(r2):
                return 1
            t0 = time.time()  # verify a new version lands server-side
            while time.time() - t0 < timeout:
                d = _kgl_cookie_api("ListKernelVersions", {"kernelId": _notebook_kernel_id()}) or {}
                if len(d.get("items", [])) > before:
                    print("version saved (verified)")
                    return 0
                time.sleep(10)
            print(f"save not confirmed within {timeout}s", file=sys.stderr)
            return 1
        sys.exit(f"unknown action {action}")
    finally:
        proc.terminate()
        shutil.rmtree(profile, ignore_errors=True)


def _kgl_cookie_api(method, body):
    """kaggle RPC with cached cookies; None on failure (verification polls)."""
    try:
        cookies = _cookie_store()
        CK = "; ".join(f"{c['name']}={c['value']}" for c in cookies)
        xsrf = [p.split("=", 1)[1] for p in CK.split("; ")
                if p.startswith("XSRF-TOKEN=")]
        if not xsrf:
            return None
        out = subprocess.check_output(
            ["curl", "-s", "--noproxy", "*", "-m", "15",
             f"https://www.kaggle.com/api/i/kernels.KernelsService/{method}",
             "-H", "content-type: application/json",
             "-H", f"x-xsrf-token: {xsrf[0]}", "-b", CK,
             "-d", json.dumps(body)]).decode()
        return json.loads(out)
    except Exception:
        return None


def _notebook_kernel_id():
    """kernelId for the configured notebook, resolved from the live session
    (ListKernelSessions items carry kernelId) and cached."""
    cache = os.path.join(CONFDIR, "kernel_id")
    if os.path.exists(cache):
        v = open(cache).read().strip()
        if v:
            return int(v)
    d = _kgl_cookie_api("ListKernelSessions", {}) or {}
    ss = d.get("sessions", [])
    if not ss:
        sys.exit("no running session to resolve kernelId; run `kgl session run-all` first")
    if len({s["kernelId"] for s in ss}) > 1:
        sys.exit("multiple notebooks have sessions; echo <id> > ~/.config/kgl/kernel_id")
    kid = ss[0]["kernelId"]
    _secure_write(cache, str(kid) + "\n")
    return kid


def _notebook_slug():
    nbfile = os.path.join(CONFDIR, "notebook")
    if os.path.exists(nbfile):
        slug = open(nbfile).read().strip()
        if slug:
            return slug
    sys.exit("no notebook configured: echo owner/slug > ~/.config/kgl/notebook")


def main():
    if len(sys.argv) < 2:
        print("usage: kgl bootstrap [sel]|watch [sel] [...]|session stop|run-all|save|status|exec CODE|sh CMD|get REMOTE [LOCAL]|put LOCAL REMOTE", file=sys.stderr)
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "bootstrap":
        return bootstrap(sys.argv[2] if len(sys.argv) > 2 else None)
    if cmd == "watch":
        # kgl watch [title] [--interval N] [--once]
        args = sys.argv[2:]
        interval = 60
        once = False
        sel = None
        it = iter(args)
        for a in it:
            if a == "--once":
                once = True
            elif a == "--interval":
                interval = int(next(it))
            else:
                sel = a
        return sys.exit(watch(sel, interval, once))
    if cmd == "session":
        if len(sys.argv) < 3 or sys.argv[2] not in ("stop", "run-all", "save"):
            sys.exit("usage: kgl session stop|run-all|save")
        return sys.exit(_headless_action(sys.argv[2]))
    if cmd == "status":
        print(json.dumps(api("api/kernels"), indent=1))
        print("terminals:", json.dumps(api("api/terminals")))
        return
    if cmd == "exec":
        return sys.exit(run_code(sys.argv[2], kernel_id=os.environ.get("KGL_KERNEL")))
    if cmd == "sh":
        # exit-code marker goes to stderr; stdout stays verbatim.
        # ponytail: remote output decoded with errors=replace (binary-safe);
        # byte-exact binary output should go through files + kgl get.
        # Runs via exec in a throwaway namespace so notebook variables are untouched.
        inner = (
            "import subprocess,sys\n"
            "p=subprocess.run(%r,shell=True,capture_output=True)\n"
            "def d(b):\n"
            "    try:\n"
            "        return b.decode('utf-8'),False\n"
            "    except UnicodeDecodeError:\n"
            "        return b.decode('utf-8','replace'),True\n"
            "so,bo=d(p.stdout)\n"
            "se,be=d(p.stderr)\n"
            "sys.stdout.write(so)\n"
            "sys.stderr.write(se)\n"
            "print(f'[exit {p.returncode} badutf={bo or be}]',file=sys.stderr)\n"
            ) % sys.argv[2]
        # repr() embeds the wrapper verbatim (no second string-parse of the
        # command); exec in a throwaway dict touches no notebook global
        code = "exec(%s, {})" % repr(inner)
        import io, contextlib
        buf_out, buf_err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(buf_out), contextlib.redirect_stderr(buf_err):
            rc = run_code(code, kernel_id=os.environ.get("KGL_KERNEL"))
        out, err = buf_out.getvalue(), buf_err.getvalue()
        rc_shell, badutf = 1, False
        if rc == 0 and "[exit " in err:
            idx = err.rfind("[exit ")
            tail = err[idx:].split("]")[0].split()
            rc_shell = int(tail[1])
            badutf = "badutf=True" in tail
            err = err[:idx]  # drop marker suffix exactly; command bytes untouched
        sys.stdout.write(out)
        sys.stderr.write(err)
        if badutf:
            print("warning: output contained invalid UTF-8 (shown as replacement chars); "
                  "use kgl put/get files for exact bytes", file=sys.stderr)
        sys.exit(rc_shell if rc == 0 else rc)
    if cmd == "get":
        remote = sys.argv[2]
        r = api(f"api/contents/{qpath(remote)}?content=1")
        out = sys.argv[3] if len(sys.argv) > 3 else os.path.basename(remote)
        if r["format"] == "text":
            open(out, "w").write(r["content"])
        elif r["format"] == "json":
            open(out, "w").write(json.dumps(r["content"], indent=1))
        elif r["format"] == "base64":
            open(out, "wb").write(base64.b64decode(r["content"]))
        else:
            sys.exit(f"format {r['format']} not supported")
        print(f"wrote {out} ({os.path.getsize(out)} bytes)")
        return
    if cmd == "put":
        local, remote = sys.argv[2], sys.argv[3]
        parent = os.path.dirname(remote.strip("/"))
        for i, _ in enumerate(parent.split("/")) if parent else []:
            sub = "/".join(parent.split("/")[:i + 1])
            try:
                api(f"api/contents/{qpath(sub)}", {"type": "directory"}, "PUT")
            except SystemExit:
                pass  # already exists
        data = open(local, "rb").read()
        body = {"type": "file", "format": "base64",
                "content": base64.b64encode(data).decode()}
        r = api(f"api/contents/{qpath(remote)}", body, "PUT")
        print("put ok:", r["path"])
        return
    if cmd == "term":
        # Kaggle's jupyter-proxy does not expose the terminado websocket
        # (/api/terminals/websocket/N always 404s; their "console" is kernel-based).
        sys.exit("kgl term unsupported: kaggle blocks the terminal websocket; "
                 "use kgl sh / exec (kernel channel works fine)")
    sys.exit(f"unknown cmd {cmd}")


if __name__ == "__main__":
    main()
