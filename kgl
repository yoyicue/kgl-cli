def _fb_session(which=None):
    """Run the firebase auth chain once. Returns (run_id, doc, idt, kgl_api)."""
    cookies = _cookie_store()
    CK = "; ".join(f"{c['name']}={c['value']}" for c in cookies)
    xsrf = [p.split("=", 1)[1] for p in CK.split("; ") if p.startswith("XSRF-TOKEN=")]
    if not xsrf:
        sys.exit("cookies have no XSRF-TOKEN — expired? re-login to kaggle "
                 "and refresh ~/.config/kgl/cookies.json")
    XSRF = xsrf[0]

    def kgl_api(method, body="{}"):
        code, out = _post_json(
            f"https://www.kaggle.com/api/i/kernels.KernelsService/{method}",
            json.loads(body), {"x-xsrf-token": XSRF, "cookie": CK})
        if code >= 400 or out is None:
            sys.exit(f"{method}: " + _auth_err(code, out))
        return out

    sessions = kgl_api("ListKernelSessions").get("sessions", [])
    run = _select_session(sessions, which)
    print(f"session: {run['title']} (kernelRunId {run['kernelRunId']})")

    tok = kgl_api("GetFirebaseAuthToken")["authToken"]
    code, out = _post_json(
        f"https://identitytoolkit.googleapis.com/v1/accounts:signInWithCustomToken?key={FB_KEY}",
        {"token": tok, "returnSecureToken": True}, {})
    if code >= 400 or not (out or {}).get("idToken"):
        sys.exit("firebase signIn: " + _auth_err(code, out))
    idt = out["idToken"]

    upd = kgl_api("UpdateUserKernelFirestoreAuth",
                  json.dumps({"firebaseIdToken": idt, "kernelRunId": run["kernelRunId"]}))
    doc = upd.get("sessionId")
    if not doc:
        sys.exit("UpdateUserKernelFirestoreAuth returned empty sessionId: " + str(upd)[:150])
    return run["kernelRunId"], doc, idt, kgl_api


def _fs_get(doc, sub, idt):
    """GET a sessions/<doc>/data/<sub> Firestore doc via 0600 -K config."""
    import tempfile
    kf = tempfile.NamedTemporaryFile("w", suffix=".kgl", delete=False)
    try:
        try:
            os.chmod(kf.name, 0o600)
            kf.write(f'header = "Authorization: Bearer {idt}"\n')
            kf.close()
        except BaseException:
            kf.close()
            os.unlink(kf.name)
            raise
        p = None
        for i in range(3):
            p = subprocess.run(
                ["curl", "-s", "--noproxy", "*", "-m", "20", "-w", "\n%{http_code}", "-K", kf.name,
                 f"{FS_BASE}/sessions/{doc}/data/{sub}"],
                capture_output=True)
            if p.returncode == 0 and p.stdout:
                break
            time.sleep(1)
    finally:
        try:
            os.unlink(kf.name)
        except FileNotFoundError:
            pass
    if not p or not p.stdout:
        return None, 0
    out, _, code = p.stdout.decode().rpartition("\n")
    try:
        return json.loads(out), int(code)
    except ValueError:
        return None, int(code or 0)


def bootstrap(which=None):
    """Pure-HTTP mint of the /k/ route — no browser at all."""
    _run_id, doc, idt, _api = _fb_session(which)

    url_doc, code = _fs_get(doc, "JupyterURL", idt)
    try:
        url = url_doc["fields"]["url"]["stringValue"]
    except Exception:
        sys.exit("JupyterURL read: " + _auth_err(code, str(url_doc)[:200]))
    _secure_write(BASEFILE, url.rstrip("/") + "\n")
    print("saved:", url[:90] + "…")


_MISSING = object()  # sentinel: field absent / unparsable, distinct from real 0


def _fs_num(v, default=_MISSING):
    """Extract a number from any Firestore Value variant.
    Returns `default` (MISSING by default) when absent/unparsable so callers
    can distinguish 'no data' from a genuine zero."""
    if not isinstance(v, dict):
        return default
    for k in ("doubleValue", "integerValue", "stringValue"):
        if k in v:
            try:
                return float(v[k])
            except (TypeError, ValueError):
                return default
    return default


def watch(which=None, interval=60, once=False):
    """Poll Firestore Status + ResourceUsage; alert on session death or idle GPU.
    Re-runs the auth chain when the 1h idToken expires (403)."""
    _run_id, doc, idt, _api = _fb_session(which)
    pinned_run_id = _run_id  # re-auth must never switch to a different session
    t_mint = time.time()
    print(f"watching (interval {interval}s, Ctrl-C to stop)…", flush=True)
    gpu_was_busy = None
    while True:
        st, code = _fs_get(doc, "Status", idt)
        if code in (401, 403) and time.time() - t_mint > 60:
            # idToken (1h TTL) expired or revoked -> re-mint the chain once,
            # pinned to the original kernelRunId
            try:
                _run_id, doc, idt, _api = _fb_session(str(pinned_run_id))
                t_mint = time.time()
                st, code = _fs_get(doc, "Status", idt)
            except SystemExit as e:
                print(f"re-auth failed: {e}", file=sys.stderr)
                st, code = None, code
        if code >= 400 or st is None or "error" in (st or {}):
            # read/auth failure — NOT the same as session death
            print("Status read failed: " + _auth_err(code, st), file=sys.stderr, flush=True)
            if once:
                return 3
            time.sleep(interval)
            continue
        f = st.get("fields", {})
        status = _fs_num(f.get("status"))
        if status is _MISSING:
            print("Status doc has no parsable status field — response format "
                  "changed? refusing to guess death", file=sys.stderr, flush=True)
            if once:
                return 3
            time.sleep(interval)
            continue
        status = int(status)
        done = int(_fs_num(f.get("doneStatus"), 0))    # optional display fields
        reason = int(_fs_num(f.get("doneReason"), 0))
        if status != 4:
            print(f"ALERT: session not RUNNING (status={status} done={done} "
                  f"reason={reason}) — it likely died or was reclaimed", flush=True)
            return 2
        ru, rcode = _fs_get(doc, "ResourceUsage", idt)
        if rcode < 400 and ru and "error" not in ru:
            f = ru.get("fields", {})
            gpus = [g["mapValue"]["fields"] for g in
                    f.get("gpus", {}).get("arrayValue", {}).get("values", [])]
            gpu_raw = [(_fs_num(g.get("usagePercent"))) for g in gpus]
            gpu_vals = [int(v) for v in gpu_raw if v is not _MISSING]
            ram_raw = _fs_num(f.get("ramBytes"))
            idle_at = f.get("idleTimeoutTime", {}).get("stringValue", "?")
            if not gpu_vals and ram_raw is _MISSING:
                print("ResourceUsage doc present but gpu/ram fields missing — "
                      "metrics unavailable this tick", file=sys.stderr, flush=True)
            else:
                gpu_pct = max(gpu_vals) if gpu_vals else None
                ram_gb = (ram_raw / 1e9) if ram_raw is not _MISSING else None
                gpu_s = f"{gpu_pct}%" if gpu_pct is not None else "?"
                ram_s = f"{ram_gb:.1f}GB" if ram_gb is not None else "?"
                print(f"[{time.strftime('%H:%M:%S')}] gpu={gpu_s} "
                      f"ram={ram_s} idle-kill@{idle_at[11:19] if idle_at != '?' else '?'}", flush=True)
                if gpu_pct is not None:
                    if gpu_was_busy and gpu_pct == 0:
                        print("NOTE: GPU dropped to 0% — training may have finished or crashed", flush=True)
                    gpu_was_busy = gpu_pct > 0
        else:
            print("ResourceUsage read failed: " + _auth_err(rcode, ru),
                  file=sys.stderr, flush=True)  # continuous mode: metrics degraded, keep watching
            if once:
                return 3
        if once:
            return 0
        time.sleep(interval)

def pick_kernel_id():
    """Kernel of the notebook session, KGL_KERNEL override, else fail loudly."""
    if os.environ.get("KGL_KERNEL"):
        return os.environ["KGL_KERNEL"]
    sessions = api("api/sessions")
    if not sessions:
        sys.exit("no running session; run a cell in the notebook first")
    for s in sessions:
        if s.get("path") == "__notebook_source__.ipynb":
            return s["kernel"]["id"]
    sys.exit("multiple sessions and no notebook match; pick one:\n" +
             "\n".join(f'  {s["kernel"]["id"]}  {s.get("path")}' for s in sessions))


def ws_kernel(kernel_id=None):
    import websocket
    kid = kernel_id or pick_kernel_id()
    url = base().replace("https://", "wss://") + f"/api/kernels/{kid}/channels"
    # ponytail: local proxy route is flaky; 3 attempts
    for i in range(3):
        try:
            return websocket.create_connection(url, timeout=15, suppress_origin=False, origin=base())
        except Exception as e:
            if i == 2:
                raise
            time.sleep(1)


def run_code(code, timeout=600, kernel_id=None):
    """Returns process-style exit code: 0 ok, 1 error, 124 timeout."""
    ws = ws_kernel(kernel_id)
    mid = str(uuid.uuid4())
    ws.send(json.dumps({
        "header": {"msg_id": mid, "msg_type": "execute_request", "username": "kgl",
                   "session": "kgl-local", "version": "5.3"},
        "parent_header": {}, "metadata": {}, "buffers": [],
        "content": {"code": code, "silent": False, "store_history": True,
                    "user_expressions": {}, "allow_stdin": False}}))
    import websocket as _w
    t0 = time.time()
    while time.time() - t0 < timeout:
        try:
            m = json.loads(ws.recv())
        except _w.WebSocketTimeoutException:
            continue  # quiet execution; keep waiting until overall timeout
        if m.get("parent_header", {}).get("msg_id") != mid:
            continue
        t = m["msg_type"]
        if t == "stream":
            print(m["content"]["text"], end="",
                  file=sys.stderr if m["content"].get("name") == "stderr" else sys.stdout)
        elif t == "execute_result":
            print(m["content"]["data"].get("text/plain", ""), end="")
        elif t == "error":
            print("\n".join(m["content"]["traceback"][-6:]), file=sys.stderr)
            return 1
        elif t == "status" and m["content"]["execution_state"] == "idle":
            return 0
    print(f"(timeout after {timeout}s; execution may still be running remotely)", file=sys.stderr)
    return 124


