import urllib.request


def curl(url, body=None, method=None):
    """Returns (status_code, text). URL (embeds the JWE credential) goes via a
    0600 curl config file, never argv. Raises on transport failure."""
    import tempfile
    kf = tempfile.NamedTemporaryFile("w", suffix=".kgl", delete=False)
    try:
        try:
            os.chmod(kf.name, 0o600)
            kf.write(f'url = "{url}"\n')
            kf.close()
        except BaseException:
            kf.close()
            os.unlink(kf.name)
            raise
        cmd = ["curl", "-s", "--noproxy", "*", "-m", "20", "-w", "\n%{http_code}", "-K", kf.name]
        if body is not None:
            cmd += ["-X", method or "POST", "--data-binary", "@" + body]
        elif method:
            cmd += ["-X", method]
        for i in range(3):  # ponytail: local proxy route is flaky
            p = subprocess.run(cmd, capture_output=True, text=True)
            if p.returncode == 0:
                break
            if p.returncode != 28 or i == 2:  # 28 = timeout, worth retrying
                sys.exit(f"curl failed ({p.returncode}): {p.stderr[:200]}")
        out, _, code = p.stdout.rpartition("\n")
        return int(code), out
    finally:
        try:
            os.unlink(kf.name)
        except FileNotFoundError:
            pass  # already removed by the write-stage handler


def base():
    b = open(BASEFILE).read().strip()
    if not b:
        sys.exit("no base. run: kgl bootstrap")
    return b.rstrip("/")


def qpath(path):
    """URL-encode a remote path, preserving /."""
    return quote(path, safe="/")


def api(path, obj=None, method=None):
    """obj: python object -> JSON body written to temp file."""
    body = None
    try:
        if obj is not None:
            import tempfile
            f = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False)
            body = f.name  # recorded before dump: cleanup covers dump failures
            try:
                json.dump(obj, f)
            finally:
                f.close()
        code, out = curl(f"{base()}/{path}", body, method)
    finally:
        if body:
            try:
                os.unlink(body)
            except FileNotFoundError:
                pass
    if code >= 400:
        sys.exit(f"HTTP {code}: {out[:300]}")
    try:
        return json.loads(out)
    except Exception:
        sys.exit(f"bad json (HTTP {code}): {out[:200]}")


def _cdp_call(ws, method, params=None, want_id=None, timeout=10):
    import websocket as _w
    i = want_id or 1
    ws.send(json.dumps({"id": i, "method": method, "params": params or {}}))
    t0 = time.time()
    while time.time() - t0 < timeout:
        try:
            m = json.loads(ws.recv())
        except _w.WebSocketTimeoutException:
            continue
        if m.get("id") == i:
            return m
    return None


def _cookie_store():
    """Kaggle cookies: cached locally, refreshed from the 9222 browser if present."""
    cookiefile = os.path.join(CONFDIR, "cookies.json")
    src_browser = None
    try:
        ver = json.loads(subprocess.check_output(
            ["curl", "-s", "--noproxy", "*", "-m", "3", "http://localhost:9222/json/version"]))
        src_browser = ver["webSocketDebuggerUrl"]
    except Exception:
        pass
    cached = None
    if os.path.exists(cookiefile):
        cached = json.load(open(cookiefile))
    if src_browser:
        import websocket
        try:
            ws = websocket.create_connection(src_browser, timeout=15, suppress_origin=True)
            r = _cdp_call(ws, "Storage.getCookies")
            cks = [c for c in (r["result"]["cookies"] if r else []) if "kaggle" in c["domain"]]
            if cks:
                KEYS = ("name", "value", "domain", "path", "secure", "httpOnly", "sameSite", "expires")
                slim = [{k: c[k] for k in KEYS if c.get(k) is not None} for c in cks]
                # verify freshness: XSRF+session must answer an API call
                CK = "; ".join(f"{c['name']}={c['value']}" for c in slim)
                XSRF = [p.split("=", 1)[1] for p in CK.split("; ") if p.startswith("XSRF-TOKEN=")]
                if XSRF:
                    code, out = _post_json(
                        "https://www.kaggle.com/api/i/users.UsersService/GetCurrentUser",
                        {}, {"x-xsrf-token": XSRF[0], "cookie": CK})
                    out = json.dumps(out or {})
                    if '"userId"' in out or '"user"' in out:
                        json.dump(slim, open(cookiefile, "w"))
                        os.chmod(cookiefile, 0o600)
                        return slim
        except Exception:
            pass
    if cached:
        try:
            os.chmod(cookiefile, 0o600)  # tighten pre-existing cache
        except OSError:
            pass
        return cached
    if os.path.exists(cookiefile):
        return json.load(open(cookiefile))
    sys.exit("no kaggle cookies: open 9222 chrome once, or put cookies in "
             + cookiefile)


def _secure_write(path, data):
    """Write with 0600 — cookies/base hold live credentials; also tightens
    files created by older versions with wider modes."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, data if isinstance(data, bytes) else data.encode())
    finally:
        os.close(fd)
    os.chmod(path, 0o600)


def _post_json(url, body_obj, headers):
    """POST via curl; credentials via 0600 -K config file and stdin body
    (nothing secret in argv / process list). Returns (code, json-or-None)."""
    import tempfile
    kf = tempfile.NamedTemporaryFile("w", suffix=".kgl", delete=False)
    try:
        try:
            os.chmod(kf.name, 0o600)
            for h, v in headers.items():
                kf.write(f'header = "{h}: {v}"\n')
            kf.close()
        except BaseException:
            kf.close()
            os.unlink(kf.name)
            raise
        p = None
        for i in range(3):  # ponytail: local route to kaggle is flaky; retry transient failures
            p = subprocess.run(
                ["curl", "-s", "--noproxy", "*", "-m", "20", "-w", "\n%{http_code}",
                 "-K", kf.name, url, "-H", "content-type: application/json",
                 "--data-binary", "@-"],
                input=json.dumps(body_obj).encode(), capture_output=True)
            if p.returncode == 0 and p.stdout:
                break
            time.sleep(1)
    finally:
        try:
            os.unlink(kf.name)
        except FileNotFoundError:
            pass  # already removed by the write-stage handler
    if p is None or p.returncode != 0:
        return 0, None
    out, _, code = p.stdout.decode().rpartition("\n")
    try:
        return int(code), json.loads(out) if out else None
    except ValueError:
        return int(code or 0), None


def _auth_err(code, body):
    """Map HTTP failures to actionable messages."""
    err = body.get("error") if isinstance(body, dict) else None
    perm = isinstance(err, dict) and err.get("status") == "PERMISSION_DENIED"
    if code == 403 or perm:
        return ("auth failed (403): kaggle cookies expired — re-login in any "
                "chrome and re-run with 9222 debugging on, or refresh "
                "~/.config/kgl/cookies.json")
    if code == 404:
        return f"not found (404): {str(body)[:150]}"
    if code == 0:
        return f"network failure: {str(body)[:150]}"
    return f"HTTP {code}: {str(body)[:200]}"


def _select_session(sessions, which):
    """Pick exactly one session by title substring or kernelRunId; refuse to guess."""
    if not sessions:
        sys.exit("no interactive session; run a cell in the notebook once")
    if which:
        if which.isdigit():
            # numeric selector: exact kernelRunId only — never a title substring
            cand = [s for s in sessions if str(s["kernelRunId"]) == which]
        else:
            cand = [s for s in sessions if which.lower() in s.get("title", "").lower()]
    else:
        cand = sessions if len(sessions) == 1 else []
    if len(cand) != 1:
        sys.exit("ambiguous/unknown session — pick one:\n" +
                 "\n".join(f'  kgl bootstrap "{s["title"]}"   (kernelRunId {s["kernelRunId"]})'
                           for s in sessions))
    return cand[0]


