def _headless_action(action, wait=30, timeout=240):
    """Drive the Kaggle editor in headless chrome for browser-gated actions
    (stop / run-all / save — their RPCs 403 outside a browser context).
    Returns 0 on VERIFIED success, 1 on failure. Large viewport required:
    session controls are hidden below ~1280px."""
    import subprocess, tempfile, shutil, websocket
    cookies = _cookie_store()
    slug = _notebook_slug()
    profile = tempfile.mkdtemp(prefix="kgl-chrome-")
    proc = subprocess.Popen(
        [_chrome_bin(), "--headless=new", "--remote-debugging-port=0",
         f"--user-data-dir={profile}", "--no-first-run", "--disable-gpu",
         "--window-size=1920,1080"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        # port 0 -> chrome picks a free one and writes it to DevToolsActivePort
        port = None
        for _ in range(20):
            f = os.path.join(profile, "DevToolsActivePort")
            if os.path.exists(f):
                port = int(open(f).read().split()[0])
                break
            time.sleep(0.5)
        if not port:
            sys.exit("headless chrome did not start (no DevToolsActivePort)")
        ver = json.loads(subprocess.check_output(
            ["curl", "-s", "--noproxy", "*", "-m", "3",
             f"http://localhost:{port}/json/version"]))
        if "Chrome" not in ver.get("Browser", "") and "Chromium" not in ver.get("Browser", ""):
            sys.exit(f"unexpected CDP endpoint: {ver.get('Browser')}")
        ws = websocket.create_connection(ver["webSocketDebuggerUrl"], timeout=20,
                                         suppress_origin=True)
        ws.send(json.dumps({"id": 1, "method": "Storage.setCookies",
                            "params": {"cookies": cookies}}))
        t0 = time.time()
        while time.time() - t0 < 5:
            try:
                if json.loads(ws.recv()).get("id") == 1:
                    break
            except websocket.WebSocketTimeoutException:
                continue
        # create the tab and capture ITS id — never operate an unrelated tab
        tab = json.loads(subprocess.check_output(
            ["curl", "-s", "--noproxy", "*", "-m", "10", "-X", "PUT",
             f"http://localhost:{port}/json/new?https://www.kaggle.com/code/{slug}/edit"]))
        tab_id = tab["id"]
        time.sleep(wait)

        def find_tab_ws():
            tabs = json.loads(subprocess.check_output(
                ["curl", "-s", "--noproxy", "*", f"http://localhost:{port}/json/list"]))
            for t in tabs:
                if t.get("id") == tab_id and slug.split("/")[-1] in t.get("url", ""):
                    return websocket.create_connection(t["webSocketDebuggerUrl"],
                                                       timeout=30, suppress_origin=True)
            return None

        import threading
        sent_stop = {"v": False}
        sent_ids = set()        # client ids our page spoke for
        sent_reqs = []          # (ts, code) execute_requests our page issued
        harvester_ready = threading.Event()
        harvester_ok = [False]
        harvester_on = [False]

        def _start_sent_harvester(wait_ready=True):
            """(Re)start the CDP harvester. Returns True ONLY when the
            subscription was confirmed; ready-without-ok is a failed attempt
            (no iframe / no ACK / connect error) and callers must not treat
            it as subscribed."""
            if harvester_on[0]:
                return harvester_ok[0]
            harvester_on[0] = True
            harvester_ok[0] = False  # a retry starts from unconfirmed
            harvester_ready.clear()

            def run():
                try:
                    _cdp_sent_harvester(port, sent_ids, sent_reqs,
                                        sent_stop, harvester_ready, harvester_ok)
                finally:
                    harvester_on[0] = False  # exited: restart is allowed
            threading.Thread(target=run, daemon=True).start()
            if wait_ready:
                harvester_ready.wait(8)
            return harvester_ok[0]

        def _iframe_ready():
            """Editor's jupyter iframe target exists again after a reload."""
            try:
                tabs = json.loads(subprocess.check_output(
                    ["curl", "-s", "--noproxy", "*", "-m", "3",
                     f"http://localhost:{port}/json/list"]))
                return any(t.get("type") == "iframe"
                           and "jupyter-proxy" in t.get("url", "") for t in tabs)
            except Exception:
                return False

        def click(expr):
            pws = find_tab_ws()
            if not pws:
                return "tab-lost"
            pws.send(json.dumps({"id": 1, "method": "Runtime.evaluate",
                                 "params": {"expression": expr, "returnByValue": True}}))
            t0 = time.time()
            while time.time() - t0 < 10:
                try:
                    m = json.loads(pws.recv())
                except websocket.WebSocketTimeoutException:
                    continue
                if m.get("id") == 1:
                    pws.close()
                    return m["result"]["result"].get("value")
            return "no-response"

        # stop/save need the kid up front; run-all resolves lazily (a call
        # here would also consume one resolution before the pre-click phase)
        kid = None if action == "run-all" else _notebook_kernel_id(required=True)

        if action == "stop":
            r = click("(()=>{const b=[...document.querySelectorAll('button')]"
                      ".find(b=>(b.getAttribute('aria-label')||'')==='Stop session');"
                      "if(!b) return 'no-stop-btn'; b.click(); return 'stop-clicked';})()")
            print(r)
            if "clicked" not in str(r):
                # error-state sessions expose no stop control — say so instead
                # of failing silently
                pill = click("(()=>{const p=[...document.querySelectorAll('button')]"
                             ".find(b=>/Session/i.test(b.innerText)); return p?"
                             "p.innerText.replace(/\\n/g,' ').slice(0,60):'no-pill';})()")
                ok, runs = _target_sessions(kid)
                if "Error" in str(pill):
                    print(f"session is in ERROR state ({pill}); no stop control "
                          "offered — Kaggle usually reaps it; check "
                          "`kgl watch` or the web UI", file=sys.stderr)
                elif ok and not runs:
                    print("no session running for this notebook — nothing to stop")
                    return 0
                return 1
            t0 = time.time()  # verify THIS kernel's sessions are gone server-side
            while time.time() - t0 < timeout:
                ok, runs = _target_sessions(kid)
                if ok and not runs:          # confirmed empty — verified
                    print("stopped (verified)")
                    return 0
                time.sleep(8)                # ok=False or still running: keep polling
            print(f"stop not confirmed within {timeout}s", file=sys.stderr)
            return 1
        if action == "run-all":
            # Causal proof of execution, strongest first:
            #   1. execute_input on the target kernel FROM THE WEB EDITOR'S
            #      jupyter session (header.session match) whose code matches
            #      one of this notebook's cells, arriving after the click.
            #      Residual: a Run All queued before our click in the same
            #      editor — externally indistinguishable, documented.
            #   2. busy on the target kernel — ONLY when the session provably
            #      did not exist before the click (fresh kernel starts idle).
            #      Unknown pre-click state => busy proves nothing.
            import threading
            pre_counts = None
            cell_codes = None
            jsess = None           # web editor's jupyter session id
            # None = unknown (pre-click query failed), True/False = known
            session_existed = None

            def _cells_of(nb):
                """Non-empty code cell sources. Empty code cells never issue
                execute requests and must not count as the 'second cell'."""
                if not isinstance(nb, dict):
                    return None
                out = []
                for c in nb.get("cells", []):
                    if isinstance(c, dict) and c.get("cell_type") == "code":
                        t = _txt(c.get("source"))
                        if t.strip():
                            out.append(c.get("source"))
                return out

            def _txt(src):
                return "".join(src) if isinstance(src, list) else str(src or "")

            first_cell_code = None  # Run All always starts at the FIRST code cell

            listener = None       # the only consulted subscription box
            warned = [False]
            pre_kernel_idle = None  # True/False observed pre-click; None=unknown

            def _attach_listener(route, tgt, js):
                """Start one subscription attempt; return its box ONLY when
                the handshake succeeded. Failed attempts are cancelled so a
                late connection can never feed events into the verdict."""
                nonlocal listener
                if listener is not None:
                    return listener
                box = {"events": [], "stop": {"v": False}, "ok": False,
                       "ready": threading.Event(),
                       "clients": set(), "sent": sent_ids}  # SHARED buffer
                threading.Thread(target=_iopub_listener,
                                 args=(route, tgt, box, cell_codes, js),
                                 daemon=True).start()
                if box["ready"].wait(10) and box["ok"]:
                    listener = box
                    return box
                box["stop"]["v"] = True  # cancel; its events stay unread
                if not warned[0]:
                    warned[0] = True
                    print("WARNING: iopub subscription not established — "
                          "verification limited to provably-fresh busy",
                          file=sys.stderr, flush=True)
                return None

            try:
                # point at provability, not at kid resolution: an OK response
                # with ZERO sessions account-wide proves the target had none
                # even when we can't resolve its kernelId yet (first run)
                okL, dL = _kgl_cookie_api("ListKernelSessions", {})
                if okL and isinstance(dL, dict) and not dL.get("sessions"):
                    session_existed = False
                kid0 = _notebook_kernel_id(required=False)
                if kid0 is not None:
                    ok0, runs0 = _target_sessions(kid0)
                    if ok0:
                        session_existed = bool(runs0)
                        if runs0:
                            try:
                                route0 = _mint_route(str(min(runs0)))
                                _, sb0 = _fetch_json(f"{route0}/api/sessions")
                                ent = next((s for s in (sb0 or [])
                                            if isinstance(s, dict)
                                            and s.get("path") == "__notebook_source__.ipynb"),
                                           None)
                                if ent:
                                    # REST session id as the editor-client proxy:
                                    # if Kaggle's frontend uses a different
                                    # client id, no event ever matches and the
                                    # result is an honest rc 1, never a
                                    # false positive
                                    jsess = ent.get("id")
                                _, kb0 = _fetch_json(f"{route0}/api/kernels")
                                if isinstance(kb0, list):
                                    k0 = next((k for k in kb0
                                               if k.get("id") == (ent or {}).get(
                                                   "kernel", {}).get("id")), None)
                                    if k0 is not None:
                                        pre_kernel_idle = (k0.get("execution_state")
                                                           == "idle")
                                _, cb0 = _fetch_json(
                                    f"{route0}/api/contents/__notebook_source__.ipynb?content=1")
                                nb0 = (cb0 or {}).get("content") if isinstance(cb0, dict) else None
                                if isinstance(nb0, dict):
                                    cell_codes = _cells_of(nb0)
                                    if cell_codes:
                                        first_cell_code = _txt(cell_codes[0])
                                if ent:
                                    _attach_listener(route0,
                                                     ent.get("kernel", {}).get("id"), jsess)
                                    if listener is not None:
                                        # force the editor to RE-connect: its
                                        # handshake (kernel_info) reveals the
                                        # editor client id, which (empirically)
                                        # is NOT the REST session id
                                        # THE editor client id, without
                                        # timing games: our page's iframe
                                        # SENDS every jupyter message; CDP
                                        # webSocketFrameSent exposes their
                                        # header.session. Sent-from-our-page
                                        # is causal by construction.
                                        _start_sent_harvester()
                                        time.sleep(8)  # editor handshake lands
                            except SystemExit:
                                pass  # best-effort pre-click snapshot
            except SystemExit:
                pass
            # harvester BEFORE the click, subscription ACKED before we
            # click (Network.enable in another thread must not race the
            # click); if the iframe wasn't up yet, wait for it, bounded
            for _ in range(20):
                if _start_sent_harvester(wait_ready=True):
                    break
                time.sleep(3)
            # if still not ok, attribution evidence is unavailable: the run
            # can at most report 'submitted'; execution confirmation is off
            harvester_confirmed = harvester_ok[0]
            t_click = time.time()
            t_click = time.time()
            r = click("(()=>{const b=[...document.querySelectorAll('button')]"
                      ".find(b=>/Run All/i.test(b.getAttribute('aria-label')||b.innerText));"
                      "if(!b) return 'no-runall'; b.click(); return 'runall-clicked';})()")
            print(r)
            if "clicked" not in str(r):
                return 1
            try:
                late_note = False
                t0 = t_click
                while time.time() - t0 < timeout:
                    if not harvester_on[0]:  # dropped mid-run: restart it
                        _start_sent_harvester(wait_ready=False)
                    kid = _notebook_kernel_id(required=False)
                    if kid is not None:
                        ok, runs = _target_sessions(kid)
                        if ok and runs:
                            run_id = min(runs)  # kernelRUNid — mint matches on this
                            try:
                                # one-off route: never overwrites the global base
                                route = _mint_route(str(run_id), quiet=True)
                                kcode, kbody = _fetch_json(f"{route}/api/kernels")
                                scode, sbody = _fetch_json(f"{route}/api/sessions")
                                if (kcode >= 400 or scode >= 400
                                        or not isinstance(kbody, list)
                                        or not isinstance(sbody, list)):
                                    time.sleep(3)
                                    continue
                                ent = next((s for s in sbody
                                            if s.get("path") == "__notebook_source__.ipynb"),
                                           None)
                                if ent is None:
                                    time.sleep(3)
                                    continue
                                if jsess is None:
                                    jsess = ent.get("id")
                                if listener is None:
                                    # fresh session: we subscribe AFTER the click;
                                    # execution may already be over — flag it
                                    late_note = True
                                    if cell_codes is None:
                                        _, cb0 = _fetch_json(
                                            f"{route}/api/contents/__notebook_source__.ipynb?content=1")
                                        nb0 = (cb0 or {}).get("content") if isinstance(cb0, dict) else None
                                        cell_codes = _cells_of(nb0)
                                        if cell_codes:
                                            first_cell_code = _txt(cell_codes[0])
                                    _start_sent_harvester()  # page frames first
                                    _attach_listener(route,
                                                     ent.get("kernel", {}).get("id"), jsess)
                                if session_existed is False and harvester_confirmed:
                                    # provably fresh kernel: busy here IS our
                                    # click — but only with a CONFIRMED
                                    # subscription (spec: unconfirmed => rc 1)
                                    for k in kbody:
                                        if (k.get("id") == ent.get("kernel", {}).get("id")
                                                and k.get("execution_state") == "busy"):
                                            print("run-all executing (fresh session busy)")
                                            return 0
                                # KERNEL-side evidence only here (spec):
                                # confirmation requires a confirmed subscription
                                # Run-All shape verdict (ent + kbody at hand):
                                # post-click stream STARTS at the first code cell,
                                # then either reaches the SECOND cell as a
                                # DISTINCT event (post[1:] — identical-code cells
                                # need two events) or the first cell is still
                                # running (kernel busy; a long first cell must
                                # not time out mid-execution). A single queued
                                # cell that finished, even the first, does not pass.
                                if (listener is not None and listener["events"]
                                        and first_cell_code is not None
                                        and harvester_confirmed):
                                    post = _post_events(listener, t_click)
                                    if post and post[0] == first_cell_code:
                                        second = (_txt(cell_codes[1])
                                                  if len(cell_codes or []) > 1
                                                  and cell_codes[1] else None)
                                        if second is None:
                                            print("run-all executing (attributed "
                                                  "first-cell run; 1-cell notebook)")
                                            return 0
                                        if second in post[1:]:
                                            print("run-all executing (attributed "
                                                  "Run-All-shaped sequence)")
                                            return 0
                                        # idle->busy transition after the click +
                                        # an ATTRIBUTED first-cell event: the
                                        # pre-click-idle kernel cannot have been
                                        # running pre-existing work. Busy since
                                        # before the click is NOT evidence.
                                        if pre_kernel_idle is True and any(
                                                k.get("id") == ent.get("kernel", {}).get("id")
                                                and k.get("execution_state") == "busy"
                                                for k in kbody):
                                            print("run-all executing (attributed "
                                                  "first cell; idle kernel turned busy)")
                                            return 0
                            except SystemExit:
                                pass  # route mint flaky; keep polling
                    time.sleep(3)
                reqs = [c for ts, c in sent_reqs if ts > t_click]
                if (harvester_confirmed
                        and first_cell_code is not None and reqs
                        and reqs[0] == first_cell_code):
                    second = (_txt(cell_codes[1])
                              if len(cell_codes or []) > 1
                              and cell_codes[1] else None)
                    if second is None or second in reqs[1:]:
                        # window expired with no KERNEL evidence: our page did
                        # submit Run-All-shaped requests (spec: submitted —
                        # and only with a subscription confirmed BEFORE the
                        # click; a post-click recovery cannot upgrade rc)
                        print("run-all submitted (our page issued Run-All-"
                              "shaped requests; execution unconfirmed — no "
                              "kernel evidence within the window)")
                        return 0
                reason = ("no causal evidence: attributed execute_input / "
                          "provably-fresh busy")
                if session_existed is None:
                    reason += "; NOTE pre-click session state was unknown, so " \
                              "pre-existing busy could not be used as evidence"
                if late_note:
                    reason += "; NOTE subscription began after the click — " \
                              "very fast cells may have finished unobserved"
                print(f"execution not confirmed within {timeout}s — {reason}",
                      file=sys.stderr)
                return 1
            finally:
                sent_stop["v"] = True
                if listener is not None:
                    listener["stop"]["v"] = True
        if action == "save":
            kid_now = _notebook_kernel_id()
            before = None                       # refuse a failed baseline
            t0 = time.time()
            while before is None and time.time() - t0 < 30:
                ok, d = _kgl_cookie_api("ListKernelVersions", {"kernelId": kid_now})
                if ok and isinstance(d, dict):
                    before = len(d.get("items", []))
                else:
                    time.sleep(5)
            if before is None:
                print("cannot establish version-count baseline", file=sys.stderr)
                return 1
            r = click("(()=>{const b=[...document.querySelectorAll('button')]"
                      ".find(b=>/Save Version/.test(b.innerText));"
                      "if(!b) return 'no-save'; b.click(); return 'sv-clicked';})()")
            time.sleep(5)
            r2 = click("(()=>{const bs=[...document.querySelectorAll('button')]"
                       ".filter(b=>b.innerText.trim()==='Save');"
                       "if(!bs.length) return 'no-confirm'; bs[bs.length-1].click();"
                       "return 'saved';})()")
            print(r, "/", r2)
            if "saved" not in str(r2):
                return 1
            t0 = time.time()  # verify a new version lands for THIS kernel
            while time.time() - t0 < timeout:
                ok, d = _kgl_cookie_api("ListKernelVersions", {"kernelId": kid_now})
                if ok and isinstance(d, dict) and len(d.get("items", [])) > before:
                    print("version saved (verified)")
                    return 0
                time.sleep(10)
            print(f"save not confirmed within {timeout}s", file=sys.stderr)
            return 1
        sys.exit(f"unknown action {action}")
    finally:
        proc.terminate()
        shutil.rmtree(profile, ignore_errors=True)


def _kgl_cookie_api(method, body):
    """kaggle RPC via _post_json (credentials never in argv).
    Returns (ok, data): ok=False on network/parse/auth failure — callers
    must treat that as UNKNOWN, never as an empty result."""
    try:
        cookies = _cookie_store()
        CK = "; ".join(f"{c['name']}={c['value']}" for c in cookies)
        xsrf = [p.split("=", 1)[1] for p in CK.split("; ")
                if p.startswith("XSRF-TOKEN=")]
        if not xsrf:
            return False, None
        code, out = _post_json(
            f"https://www.kaggle.com/api/i/kernels.KernelsService/{method}",
            body, {"x-xsrf-token": xsrf[0], "cookie": CK})
        if code >= 400 or out is None:
            return False, None
        return True, out
    except Exception:
        return False, None


def _fetch_json(url):
    """One-off GET returning (code, parsed-json-or-None). URL goes via a 0600
    curl -K config — it embeds the JWE credential."""
    import tempfile
    kf = tempfile.NamedTemporaryFile("w", suffix=".kgl", delete=False)
    try:
        try:
            os.chmod(kf.name, 0o600)
            kf.write(f'url = "{url}"\n')
            kf.close()
        except BaseException:
            kf.close()
            os.unlink(kf.name)
            raise
        p = None
        for i in range(3):
            p = subprocess.run(
                ["curl", "-s", "--noproxy", "*", "-m", "20", "-w", "\n%{http_code}",
                 "-K", kf.name], capture_output=True)
            if p.returncode == 0 and p.stdout:
                break
            time.sleep(1)
    finally:
        try:
            os.unlink(kf.name)
        except FileNotFoundError:
            pass
    if not p or not p.stdout:
        return 0, None
    out, _, code = p.stdout.decode().rpartition("\n")
    try:
        return int(code), json.loads(out) if out else None
    except ValueError:
        return int(code or 0), None


def _cdp_sent_harvester(port, sent_ids, sent_reqs, stop, ready, ok):
    """Attach CDP Network to the editor's jupyter iframe. Harvests:
    - every header.session our page SPOKE FOR -> sent_ids (attribution)
    - every execute_request our page ISSUED -> sent_reqs (ts, code): the
      requests themselves prove SUBMISSION (not execution), immune to
      kernel-listener timing.
    `ready` = attempt finished; `ok`[0] = True ONLY when Network.enable was
    ACKED. Callers gate the click on ok, never on ready alone."""
    import websocket
    try:
        tabs = json.loads(subprocess.check_output(
            ["curl", "-s", "--noproxy", "*", "-m", "3",
             f"http://localhost:{port}/json/list"]))
        fr = next((t for t in tabs if t.get("type") == "iframe"
                   and "jupyter-proxy" in t.get("url", "")), None)
        if not fr:
            ready.set()  # attempt done; ok stays False (caller retries)
            return
        hws = websocket.create_connection(fr["webSocketDebuggerUrl"],
                                          timeout=120, suppress_origin=True)
        hws.send(json.dumps({"id": 1, "method": "Network.enable"}))
        hws.settimeout(5)
        acked = False
        t0 = time.time()
        while time.time() - t0 < 5:
            try:
                m = json.loads(hws.recv())
                if m.get("id") == 1 and "error" not in m:
                    acked = True
                    break
                if m.get("id") == 1:  # error response: NOT confirmed
                    break
            except websocket.WebSocketTimeoutException:
                break
            except Exception:
                ready.set()
                return
        if acked:
            ok[0] = True  # subscription CONFIRMED — the only ok path
        else:
            hws.close()  # half-subscribed is useless; let a retry start clean
        ready.set()
        hws.settimeout(10)
        while not stop["v"]:
            try:
                m = json.loads(hws.recv())
            except websocket.WebSocketTimeoutException:
                continue
            except Exception:
                return  # dropped; caller's retry flag lets a new one start
            if m.get("method") != "Network.webSocketFrameSent":
                continue
            try:
                payload = json.loads(m["params"]["response"]["payloadData"])
                cid = (payload.get("header") or {}).get("session")
                if cid:
                    sent_ids.add(cid)
                if (payload.get("header") or {}).get("msg_type") == "execute_request":
                    code = (payload.get("content") or {}).get("code") or ""
                    sent_reqs.append((time.time(), "".join(code)
                                      if isinstance(code, list) else str(code)))
            except Exception:
                pass
    except Exception:
        ready.set()  # attempt done; ok stays False
        return


def _post_events(box, t_click):
    """Verdict-time filter: post-click events whose parent OUR page spoke
    for (sent grows monotonically; checking here closes the CDP/iopub race)."""
    return [code for ts, code, parent in box["events"]
            if ts > t_click and parent in box["sent"]]


def _iopub_listener(route, kernel_id, box, cell_codes=None, jupyter_session=None):
    """Subscribe to the target kernel's channels. Harvests every DISTINCT
    client id seen in parent_header (any message: the editor's connect-time
    kernel_info request included — empirically, Kaggle's editor client id is
    NOT the REST session id, so it must be LEARNED). Records attributed
    execute_input (ts, code) pairs: attribution = parent in the accepted set
    (ids observed before the click snapshot) and code in this notebook's cells.
    box: {"events", "stop", "ok", "ready", "clients": set, "sent": set}."""
    import websocket

    def _txt(src):
        return "".join(src) if isinstance(src, list) else str(src or "")

    if not cell_codes:
        box["ready"].set()  # cannot attribute anything; caller sees ok=False
        return
    allow = {_txt(c) for c in cell_codes}
    try:
        url = route.replace("https://", "wss://") + f"/api/kernels/{kernel_id}/channels"
        ws = ws_connect(url, origin=route)
        ws.settimeout(3)
        box["ok"] = True
        box["ready"].set()
        while not box["stop"]["v"]:
            try:
                m = json.loads(ws.recv())
            except websocket.WebSocketTimeoutException:
                continue
            except Exception:
                return
            parent = (m.get("parent_header") or {}).get("session")
            if parent:
                box["clients"].add(parent)  # learn every connected client
            mt = m.get("msg_type") or m.get("header", {}).get("msg_type")
            if mt != "execute_input":
                continue
            # record ALL cell-matching events (ts, code, parent); the sent
            # check happens at VERDICT time — CDP frames may land after the
            # iopub message, so record-time dropping would lose fast events
            code = _txt((m.get("content") or {}).get("code"))
            if code in allow:
                box["events"].append((time.time(), code, parent))
    except Exception:
        box["ready"].set()  # failed; ok stays False
        return


def _nb_max_exec(nb):
    """Max code-cell execution_count in a notebook dict (0 if none)."""
    if not isinstance(nb, dict):
        return 0
    counts = [c.get("execution_count") or 0 for c in nb.get("cells", [])
              if isinstance(c, dict) and c.get("cell_type") == "code"]
    return max(counts) if counts else 0


def _draft_notebook(kernel_id):
    """The saved draft notebook (dict) or None — used as the pre-click
    execution baseline; works even with no running session."""
    ok, d = _kgl_cookie_api("GetOrCreateKernelSession", {"kernelId": kernel_id})
    url = ((d or {}).get("draft", {}) or {}).get("blob", {}).get("sourceUrl")
    if not ok or not url:
        return None
    _, nb = _fetch_json(url)
    return nb if isinstance(nb, dict) else None


def _iso(ts):
    """RFC3339 (2026-11-09T12:34:56.789Z) -> epoch seconds; 0 on garbage."""
    try:
        from datetime import datetime, timezone
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0


def _target_sessions(kid):
    """(ok, run_ids): sessions belonging to the target kernel only."""
    ok, d = _kgl_cookie_api("ListKernelSessions", {})
    if not ok or not isinstance(d, dict):
        return False, None
    return True, {s["kernelRunId"] for s in d.get("sessions", [])
                  if s.get("kernelId") == kid}


def _notebook_kernel_id(required=True):
    """kernelId for the configured notebook, verified to BELONG to it via
    GetKernel's url field. Cache is slug-bound. Returns None when unresolvable
    and not required (run-all resolves after the click)."""
    slug = _notebook_slug()
    cache = os.path.join(CONFDIR, "kernel_id")
    if os.path.exists(cache):
        parts = open(cache).read().strip().split()
        if len(parts) == 2 and parts[0] == slug and parts[1].isdigit():
            kid = int(parts[1])
            ok, k = _kgl_cookie_api("GetKernel", {"kernelId": kid})
            if not ok:  # ownership UNKNOWN: one retry, then refuse (never trust blind)
                time.sleep(3)
                ok, k = _kgl_cookie_api("GetKernel", {"kernelId": kid})
            if not ok:
                if required:
                    sys.exit("cannot verify kernelId cache ownership (API "
                             "unavailable); retry when kaggle API recovers")
                return None  # lazy callers keep polling
            url = ((k or {}).get("url") or "").rstrip("/")
            if url == f"/code/{slug}":
                return kid
            os.unlink(cache)  # CONFIRMED foreign — drop (once) and re-resolve
    ok, d = _kgl_cookie_api("ListKernelSessions", {})
    if not ok or not isinstance(d, dict):
        if required:
            sys.exit("cannot resolve kernelId: session list unavailable")
        return None
    kids = sorted({s["kernelId"] for s in d.get("sessions", [])})
    for kid in kids:  # a live session is only a CANDIDATE until verified
        ok, k = _kgl_cookie_api("GetKernel", {"kernelId": kid})
        url = ((k or {}).get("url") or "").rstrip("/")
        if ok and url == f"/code/{slug}":
            _secure_write(cache, f"{slug} {kid}\n")
            return kid
    if required:
        sys.exit(f"cannot resolve kernelId for {slug}; no session of this notebook "
                 "is running and the cache is empty — seed it once:\n"
                 f"  echo '{slug} <kernelId>' > ~/.config/kgl/kernel_id")
    return None


def _notebook_slug():
    nbfile = os.path.join(CONFDIR, "notebook")
    if os.path.exists(nbfile):
        slug = open(nbfile).read().strip()
        if slug:
            return slug
    sys.exit("no notebook configured: echo owner/slug > ~/.config/kgl/notebook")


def main():
    if len(sys.argv) < 2:
        print("usage: kgl bootstrap [sel]|watch [sel] [...]|session stop|run-all|save|status|exec CODE|sh CMD|get REMOTE [LOCAL]|put LOCAL REMOTE", file=sys.stderr)
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "bootstrap":
        return bootstrap(sys.argv[2] if len(sys.argv) > 2 else None)
    if cmd == "watch":
        # kgl watch [title] [--interval N] [--once]
        args = sys.argv[2:]
        interval = 60
        once = False
        sel = None
        it = iter(args)
        for a in it:
            if a == "--once":
                once = True
            elif a == "--interval":
                interval = int(next(it))
            else:
                sel = a
        return sys.exit(watch(sel, interval, once))
    if cmd == "session":
        if len(sys.argv) < 3 or sys.argv[2] not in ("stop", "run-all", "save"):
            sys.exit("usage: kgl session stop|run-all|save")
        return sys.exit(_headless_action(sys.argv[2]))
    if cmd == "status":
        print(json.dumps(api("api/kernels"), indent=1))
        print("terminals:", json.dumps(api("api/terminals")))
        return
    if cmd == "exec":
        return sys.exit(run_code(sys.argv[2], kernel_id=os.environ.get("KGL_KERNEL")))
    if cmd == "sh":
        # exit-code marker goes to stderr; stdout stays verbatim.
        # ponytail: remote output decoded with errors=replace (binary-safe);
        # byte-exact binary output should go through files + kgl get.
        # Runs via exec in a throwaway namespace so notebook variables are untouched.
        inner = (
            "import subprocess,sys\n"
            "p=subprocess.run(%r,shell=True,capture_output=True)\n"
            "def d(b):\n"
            "    try:\n"
            "        return b.decode('utf-8'),False\n"
            "    except UnicodeDecodeError:\n"
            "        return b.decode('utf-8','replace'),True\n"
            "so,bo=d(p.stdout)\n"
            "se,be=d(p.stderr)\n"
            "sys.stdout.write(so)\n"
            "sys.stderr.write(se)\n"
            "print(f'[exit {p.returncode} badutf={bo or be}]',file=sys.stderr)\n"
            ) % sys.argv[2]
        # repr() embeds the wrapper verbatim (no second string-parse of the
        # command); exec in a throwaway dict touches no notebook global
        code = "exec(%s, {})" % repr(inner)
        import io, contextlib
        buf_out, buf_err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(buf_out), contextlib.redirect_stderr(buf_err):
            rc = run_code(code, kernel_id=os.environ.get("KGL_KERNEL"))
        out, err = buf_out.getvalue(), buf_err.getvalue()
        rc_shell, badutf = 1, False
        if rc == 0 and "[exit " in err:
            idx = err.rfind("[exit ")
            tail = err[idx:].split("]")[0].split()
            rc_shell = int(tail[1])
            badutf = "badutf=True" in tail
            err = err[:idx]  # drop marker suffix exactly; command bytes untouched
        sys.stdout.write(out)
        sys.stderr.write(err)
        if badutf:
            print("warning: output contained invalid UTF-8 (shown as replacement chars); "
                  "use kgl put/get files for exact bytes", file=sys.stderr)
        sys.exit(rc_shell if rc == 0 else rc)
    if cmd == "get":
        remote = sys.argv[2]
        r = api(f"api/contents/{qpath(remote)}?content=1")
        out = sys.argv[3] if len(sys.argv) > 3 else os.path.basename(remote)
        if r["format"] == "text":
            open(out, "w").write(r["content"])
        elif r["format"] == "json":
            open(out, "w").write(json.dumps(r["content"], indent=1))
        elif r["format"] == "base64":
            open(out, "wb").write(base64.b64decode(r["content"]))
        else:
            sys.exit(f"format {r['format']} not supported")
        print(f"wrote {out} ({os.path.getsize(out)} bytes)")
        return
    if cmd == "put":
        local, remote = sys.argv[2], sys.argv[3]
        parent = os.path.dirname(remote.strip("/"))
        for i, _ in enumerate(parent.split("/")) if parent else []:
            sub = "/".join(parent.split("/")[:i + 1])
            try:
                api(f"api/contents/{qpath(sub)}", {"type": "directory"}, "PUT")
            except SystemExit:
                pass  # already exists
        data = open(local, "rb").read()
        body = {"type": "file", "format": "base64",
                "content": base64.b64encode(data).decode()}
        r = api(f"api/contents/{qpath(remote)}", body, "PUT")
        print("put ok:", r["path"])
        return
    if cmd == "term":
        # Kaggle's jupyter-proxy does not expose the terminado websocket
        # (/api/terminals/websocket/N always 404s; their "console" is kernel-based).
        sys.exit("kgl term unsupported: kaggle blocks the terminal websocket; "
                 "use kgl sh / exec (kernel channel works fine)")
    sys.exit(f"unknown cmd {cmd}")


if __name__ == "__main__":
    main()
